generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
enum VehicleStatus { DRAFT AVAILABLE RESERVED SOLD ARCHIVED }
model Brand { id String @id @default(cuid()) slug String @unique name String logoUrl String? vehicles Vehicle[] }
model Vehicle {
  id String @id @default(cuid()) slug String @unique brandId String brand Brand @relation(fields:[brandId],references:[id])
  model String trim String? year Int price Int mileage Int bodyType String fuelType String transmission String
  engine String? horsepower Int? exteriorColor String? description String? status VehicleStatus @default(DRAFT)
  featured Boolean @default(false) publishedAt DateTime? soldAt DateTime? media VehicleMedia[] leads Lead[]
}
model VehicleMedia { id String @id @default(cuid()) vehicleId String vehicle Vehicle @relation(fields:[vehicleId],references:[id]) type String url String alt String? sortOrder Int @default(0) }
model Lead { id String @id @default(cuid()) type String vehicleId String? vehicle Vehicle? @relation(fields:[vehicleId],references:[id]) name String email String? phone String? message String? status String @default("new") createdAt DateTime @default(now()) }
model SellSubmission { id String @id @default(cuid()) make String model String year Int mileage Int condition String desiredPrice Int? contactName String contactPhone String status String @default("new") createdAt DateTime @default(now()) }
model Article { id String @id @default(cuid()) slug String @unique title String excerpt String body String coverImage String? publishedAt DateTime? }
